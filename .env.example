# Flatland — docker-compose env (copy to .env and tweak)
# Only the variables you actually set matter; every entry below shows the default.

# ── Ports (host side) ──────────────────────────────────────────────────────
BACKEND_PORT=8000
FRONTEND_PORT=5173

# ── Security & Authentication ─────────────────────────────────────────────
# FLATWORLD_GOD_KEY=change_me_to_a_secure_god_passkey

# ── World / Simulation (all optional) ─────────────────────────────────────
FLATWORLD_WIDTH=400
FLATWORLD_HEIGHT=300
FLATWORLD_SEED=42
FLATWORLD_TICK_RATE=10
FLATWORLD_FOOD_COUNT=380
FLATWORLD_CARRYING_CAPACITY=350
FLATWORLD_MAX_POPULATION=420
FLATWORLD_PERCEIVE_RADIUS=16
FLATWORLD_OMP_ENABLED=true
FLATWORLD_OMP_THRESHOLD=100

# Add any other FLATWORLD_* overrides supported by backend/app/config.py
# e.g. FLATWORLD_DISEASE_ENABLED=true  FLATWORLD_WAR_ENABLED=true
