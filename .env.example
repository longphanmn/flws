# Flatland — docker-compose env (copy to .env and tweak)
# Only the variables you actually set matter; every entry below shows the default.

# ── Ports (host side) ──────────────────────────────────────────────────────
BACKEND_PORT=8000
FRONTEND_PORT=5173

# ── Security & Authentication ─────────────────────────────────────────────
# FLATWORLD_GOD_KEY=change_me_to_a_secure_god_passkey
# Optional automation value; otherwise startup generates and prints a one-time token.
# FLATWORLD_BOOTSTRAP_TOKEN=change_me_to_a_unique_bootstrap_token
# Exact comma-separated browser origins. Replace the example LAN address as needed.
FLATWORLD_ALLOWED_ORIGINS=http://192.168.1.10:5173,http://203.0.113.10:5173,https://world.minhnhan.in
# Comma-separated reverse-proxy IPs/CIDRs. Empty (default) ignores X-Forwarded-For.
# FLATWORLD_TRUSTED_PROXIES=172.18.0.0/16

# ── World / Simulation (all optional) ─────────────────────────────────────
FLATWORLD_WIDTH=400
FLATWORLD_HEIGHT=300
FLATWORLD_SEED=42
FLATWORLD_TICK_RATE=10
FLATWORLD_FOOD_COUNT=380
FLATWORLD_CARRYING_CAPACITY=350
FLATWORLD_MAX_POPULATION=420
FLATWORLD_PERCEIVE_RADIUS=16
FLATWORLD_OMP_ENABLED=true
FLATWORLD_OMP_THRESHOLD=100

# ── Remote API & Demo (GitHub Pages) ──────────────────────────────────────
# The demo hosted on GitHub Pages points to this backend API URL.
API_URL=https://example.com
# WS_URL=wss://example.com/ws

# Frontend application URL (demo / live simulation)
FRONTEND_URL=https://longphanmn.github.io/flws-web/

# Project landing page URL
LANDING_URL=https://longphanmn.github.io/flws-page/

# Add any other FLATWORLD_* overrides supported by backend/app/config.py
# e.g. FLATWORLD_DISEASE_ENABLED=true  FLATWORLD_WAR_ENABLED=true

# ── Multi-Repo Code Structure Paths (Optional) ─────────────────────────────
# Path to web frontend repository (flws-web). Defaults to ../flws-web (sibling).
FRONTEND_DIR=../flws-web
BACKEND_DIR=./backend
LANDING_DIR=../flws-page

